[Unit]
Description=OzPrint — Open-Source Document Management & Print Orchestration Platform
After=network.target cups.service
Wants=cups.service

[Service]
Type=simple
User=maverick
WorkingDirectory=/home/maverick/Ozprint
Environment="NODE_ENV=production"
Environment="PORT=4000"
Environment="STORAGE_ROOT=/var/lib/ozprint"
Environment="SQLITE_PATH=/var/lib/ozprint/ozprint.db"
Environment="PYTHON_BINARY=/usr/bin/python3"
EnvironmentFile=-/etc/ozprint/ozprint.env
ExecStart=/usr/bin/node /home/maverick/Ozprint/apps/server/dist/index.js
Restart=on-failure
RestartSec=5

# Systemd Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/var/lib/ozprint /home/maverick/Ozprint

[Install]
WantedBy=multi-user.target
