# OzPrint Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-64-char-random-secret-in-production

# Persistence & Storage
# DB_DRIVER supports: sqlite (default, better-sqlite3 WAL mode) | postgres
DB_DRIVER=sqlite
SQLITE_PATH=./storage/ozprint.db
DATABASE_URL=postgres://ozprint:ozprint@localhost:5432/ozprint
STORAGE_ROOT=./storage

# Print Orchestration & CUPS Polling
CUPS_POLL_INTERVAL_MS=2000
CUPS_TIMEOUT_MS=15000

# Python Worker Binary (/usr/bin/python3 on Linux/Docker)
PYTHON_BINARY=/usr/bin/python3

# Default Bootstrap Admin Account & Quotas
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@ozprint.local
DEFAULT_ADMIN_PASSWORD=ozprint-admin
DEFAULT_MONTHLY_QUOTA=500

# Retention & Cleanup Policies
DOCUMENT_TTL_HOURS=168
KIOSK_SESSION_TTL_MINUTES=30
CLEANUP_INTERVAL_MS=60000
